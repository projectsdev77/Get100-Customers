# Copy to .env.local and fill in. See PHASES.md for which phase needs which key,
# and which of these are free-tier for dev vs. need a paid swap before launch.

# --- Supabase (Phase 1) --- free tier, no card required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini API (Phase 2) --- free tier via Google AI Studio, no card required
GEMINI_API_KEY=

# --- Resend (Phase 8) --- free tier, no card required
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Stripe (Phase 10) --- test mode keys are free, no business verification needed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
