# Copy to .env.local and fill in. See PHASES.md for which phase needs which key,
# and which of these are free-tier for dev vs. need a paid swap before launch.

# --- Supabase (Phase 1) --- free tier, no card required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini API (Phase 2) --- free tier via Google AI Studio, no card required
GEMINI_API_KEY=

# --- Groq (optional, free) --- fallback LLM used only when Gemini hits its
# free-tier quota (20 requests/day per model — tight for active testing).
# Get a key at console.groq.com. Leave blank and the app behaves exactly as
# before: a Gemini failure just falls back to the raw template / a "try
# again" message, same as without Groq configured at all.
GROQ_API_KEY=

# --- Resend (Phase 8) --- free tier, no card required
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Weekly recap cron (Phase 8) --- shared secret, generate any random string.
# Also set as a GitHub Actions secret (CRON_SECRET) alongside APP_URL —
# see .github/workflows/weekly-recap.yml
CRON_SECRET=

# --- Stripe (Phase 10) --- test mode keys are free, no business verification needed.
# STRIPE_PRICE_ID is the single-tier subscription Price id (SPEC §3) from
# the Stripe test-mode dashboard. Checkout/portal redirect server-side, so
# no publishable key is needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
